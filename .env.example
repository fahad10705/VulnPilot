# Copy to .env and fill in. NEVER commit .env. Deployed app: use Streamlit Secrets (same names).
# Every AI key is optional. The app tries the services in this order and always gives an answer:
# Nebius, OpenRouter, Groq, Google. With no key it shows a labelled OFFLINE SAMPLE.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
# Blockchain (all three needed, otherwise demo mode):
SEPOLIA_RPC_URL=
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=
